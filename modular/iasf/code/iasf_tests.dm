#if defined(UNIT_TESTS) || defined(SPACEMAN_DMM)
/datum/unit_test/iasf_gm_squads/Run()
	var/datum/human_squad_spawner_menu/menu = new()
	var/list/data = menu.ui_static_data(null)
	var/list/squads_by_faction = data["squads"]
	var/list/iasf_squads = squads_by_faction[FACTION_IASF]
	if(length(iasf_squads) != 5)
		return Fail("IASF squads are missing from the Game Master spawner", __FILE__, __LINE__)
	for(var/datum/human_ai_squad_preset/iasf/preset_type as anything in subtypesof(/datum/human_ai_squad_preset/iasf))
		if(!GLOB.human_ai_squad_presets["[preset_type]"])
			return Fail("[preset_type] is unavailable to Game Masters", __FILE__, __LINE__)
	qdel(menu)

/datum/unit_test/iasf_radio_pack/Run()
	var/turf/test_turf = locate(1, 1, 1)
	for(var/pack_type as anything in list(/obj/item/storage/backpack/marine/satchel/rto/twe_net/iasf, /obj/item/storage/backpack/marine/satchel/rto/pmc_net))
		var/obj/item/storage/backpack/marine/satchel/rto/pack = new pack_type(test_turf)
		var/datum/component/phone/phone_component = pack.GetComponent(/datum/component/phone)
		if(!phone_component?.phone_handset)
			return Fail("[pack_type] has no working handset", __FILE__, __LINE__)
		if(!(phone_component.phone_handset.icon_state in icon_states(phone_component.phone_handset.icon)))
			return Fail("[pack_type] has no handset sprite", __FILE__, __LINE__)
		pack.phone_picked_up()
		if(!(pack.icon_state in icon_states(pack.icon)) || !(pack.item_state in icon_states(pack.item_icons[WEAR_BACK])))
			return Fail("[pack_type] has no open sprite", __FILE__, __LINE__)
		pack.phone_hung_up()
		if(!(pack.icon_state in icon_states(pack.icon)) || !(pack.item_state in icon_states(pack.item_icons[WEAR_BACK])))
			return Fail("[pack_type] has no closed sprite", __FILE__, __LINE__)
		qdel(pack)

/datum/unit_test/iasf_f90_magazines/Run()
	for(var/magazine_type as anything in list(/obj/item/ammo_magazine/rifle/rmc_f90, /obj/item/ammo_magazine/rifle/rmc_f90/ap, /obj/item/ammo_magazine/rifle/rmc_f90/heap, /obj/item/ammo_magazine/rifle/rmc_f90/marksman, /obj/item/ammo_magazine/rifle/rmc_f90/marksman/ap, /obj/item/ammo_magazine/rifle/rmc_f90/marksman/heap))
		var/obj/item/ammo_magazine/rifle/rmc_f90/magazine = new magazine_type()
		if(magazine.max_rounds != 60 || magazine.current_rounds != 60)
			return Fail("[magazine_type] does not contain 60 rounds", __FILE__, __LINE__)
		qdel(magazine)
#endif
