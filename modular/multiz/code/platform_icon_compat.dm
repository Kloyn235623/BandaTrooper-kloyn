// These stair families inherit helper DMI redirects, but their map states are only present in the canonical platform sheet.
/obj/structure/platform/metal/stair_cut/strata_left
	icon = 'icons/obj/structures/props/platforms.dmi'

/obj/structure/platform/metal/stair_cut/strata_left/alt
	icon = 'icons/obj/structures/props/platforms.dmi'

/obj/structure/platform/metal/stair_cut/strata_right
	icon = 'icons/obj/structures/props/platforms.dmi'

/obj/structure/platform/stone/stair_cut
	icon = 'icons/obj/structures/props/platforms.dmi'

// The source DMI's wood stair variants are editor placeholders (red arrows), not usable sprites.
/obj/structure/platform/wood/stair_cut/platform_left
	icon = 'icons/obj/structures/props/platforms.dmi'
	icon_state = "platform_stair"
	color = "#9b7655"

/obj/structure/platform/wood/stair_cut/platform_right
	icon = 'icons/obj/structures/props/platforms.dmi'
	icon_state = "platform_stair_alt"
	color = "#9b7655"
